#!/bin/sh
# bw: run one bytewyrd command under Python 3.11 or newer.
#
#   sh scripts/bw NAME [ARGS...]
#
# Class A is scaffold, drift, state-touch and compact-reminder; class B is the
# JSON helpers (rfc-* and tool-probe). The interpreter is $BYTEWYRD_PYTHON when
# it reports 3.11 or newer, else the first of python3.15 ... python3.11 on PATH
# (trusted by name), else python3 when it reports 3.11 or newer. With none of
# them, class A exits 1 and class B exits 2 with a JSON error, both on stderr,
# except that the PreCompact sentinel is still written in plain sh.
#
# Contract: docs/rfcs/2026-11-09-scaffold-and-drift.md, Appendix B2.

case $0 in
*/*) dir=${0%/*} ;;
*) dir=. ;;
esac

if [ "$#" -eq 0 ]; then
	echo 'bw: usage: bw NAME [ARGS...]' >&2
	exit 1
fi
name=$1
shift

case $name in
scaffold | drift | state-touch | compact-reminder) class=A ;;
rfc-braindump-append | rfc-braindump-list | rfc-braindump-remove | rfc-feedback-list | rfc-frontmatter | rfc-resolve | rfc-set-status | rfc-summary | tool-probe) class=B ;;
*)
	printf 'bw: unknown command: %s\n' "$name" >&2
	exit 1
	;;
esac

# One interpreter start answers "is this 3.11 or newer?". -I and -S keep
# PYTHON* variables, the user site directory and site (.pth files) out of it.
reports_311() {
	"$1" -I -S -c 'import sys; sys.exit(sys.version_info < (3, 11))' >/dev/null 2>&1
}

py=
if [ -n "${BYTEWYRD_PYTHON:-}" ] && reports_311 "$BYTEWYRD_PYTHON"; then
	py=$BYTEWYRD_PYTHON
else
	for cand in python3.15 python3.14 python3.13 python3.12 python3.11; do
		if command -v "$cand" >/dev/null 2>&1; then
			py=$cand
			break
		fi
	done
	if [ -z "$py" ] && command -v python3 >/dev/null 2>&1 && reports_311 python3; then
		py=python3
	fi
fi

if [ -z "$py" ]; then
	# The 0.2.x PreCompact hook blocks until this sentinel exists, so it is
	# written even without Python. Like the Python command, it never writes
	# through a symlink and exits 0.
	if [ "$name" = state-touch ] && [ "$#" -eq 1 ] && [ "$1" = precompact-extraction-done ]; then
		for p in .bytewyrd .bytewyrd/precompact-extraction-done; do
			if [ -L "$p" ]; then
				printf 'state-touch: %s is a symlink; refusing to write through it\n' "$p" >&2
				exit 0
			fi
		done
		mkdir -p .bytewyrd && : >.bytewyrd/precompact-extraction-done
		exit 0
	fi
	msg='bytewyrd: needs Python 3.11 or newer (set BYTEWYRD_PYTHON or install python3.11+)'
	if [ "$class" = B ]; then
		printf '{"error":"%s"}\n' "$msg" >&2
		exit 2
	fi
	printf '%s\n' "$msg" >&2
	exit 1
fi

# -I ignores PYTHON* variables and the user site directory, -S skips site, so
# a venv's .pth files never run, and -B writes no bytecode into the plugin.
exec "$py" -I -S -B "$dir/_lib/bw_main.py" "$name" "$@"
