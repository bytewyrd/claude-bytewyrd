{
  "hooks": {
    "SubagentStop": [
      {
        "matcher": "(^|:)feature-engineer$",
        "hooks": [
          {
            "type": "command",
            "command": "echo 'Post-feature-implementation: if this feature affects user-visible behavior (a new skill, an agent change, a new CLI flag, a new workflow), ask the user to run /docs-review against the changed paths to check whether docs/guide/** needs updates.'"
          },
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/bw\" state-touch last-feature-engineer-stop || true"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/bw\" compact-reminder || true"
          }
        ]
      },
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "cat \"${CLAUDE_PLUGIN_ROOT}/hooks/always-on-rules.json\""
          }
        ]
      }
    ]
  }
}
